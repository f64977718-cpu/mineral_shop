# Скопіюйте цей файл як ".env" (без .example) і заповніть. Файл .env НЕ комітити і нікому не надсилати.

# ---------- Django ----------
DJANGO_DEBUG=1                  # у продакшні поставте 0
DJANGO_SECRET_KEY=              # обов'язково при DJANGO_DEBUG=0. Згенерувати: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- База даних Aiven (PostgreSQL) ----------
# Якщо DB_HOST порожній — працює локальний SQLite.
DB_HOST=                        # хост із Aiven → Overview (виглядає як ...aivencloud.com)
DB_PORT=28433
DB_NAME=defaultdb
DB_USER=avnadmin                # перевірте в Aiven → Overview → User
DB_PASSWORD=                    # пароль із Aiven (після скидання — новий!)
DB_SSLMODE=verify-ca
DB_SSLROOTCERT=certs/aiven-ca.pem   # сертифікат уже лежить у проєкті
# Альтернатива всьому вище — один рядок: DATABASE_URL=postgres://user:pass@host:port/defaultdb?sslmode=require

# ---------- Оплата ----------
SITE_URL=http://127.0.0.1:8000  # публічна адреса сайту (для повернення з оплати і вебхуків)
PAYMENT_PROVIDER=mock           # mock (тільки розробка) | stripe | liqpay
PAYMENT_CURRENCY=UAH
PAYMENT_PENDING_TTL_MINUTES=90

# Stripe (PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LiqPay (PAYMENT_PROVIDER=liqpay)
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=0

# За nginx/балансувальником:
# USE_X_FORWARDED_FOR=1
# BEHIND_PROXY=1
# CSRF_TRUSTED_ORIGINS=https://your-domain.ua
